# Copia este archivo como .env y pega tus llaves (todas opcionales).
# Fotos de stock gratis con uso comercial (se usa la primera que tenga valor).
# Pixabay: llave inmediata y gratis en https://pixabay.com/api/docs/ (inicia sesión y aparece arriba)
PIXABAY_API_KEY=
# Pexels: https://www.pexels.com/api/ (en oct. 2026 pausó la emisión de llaves nuevas)
PEXELS_API_KEY=
# Alternativa: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Imágenes generadas con IA: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
